---
import Base from '../layouts/Base.astro';
import StickyNav from '../components/nav/StickyNav';
import DealFeed from '../components/feed/DealFeed';
import fs from 'node:fs';
import path from 'node:path';

const dataPath = path.join(process.cwd(), 'public', 'site-data.json');
const raw = fs.readFileSync(dataPath, 'utf-8');
const data = JSON.parse(raw);
const initialDeals = data.posts.slice(0, 5);
---
<Base>
  <StickyNav client:load onSearchClick={() => {
    window.dispatchEvent(new CustomEvent('noya:toggleSearch'));
  }} />
  <DealFeed client:load initialDeals={initialDeals} />
</Base>
