---
import Base from '../../layouts/Base.astro';

interface Deal {
  slug: string;
  asin: string;
  title: string;
  url: string;
  price: string | null;
  discount: number;
  rating: string;
  category: string;
  ts: string;
  type: string;
  imageUrl: string | null;
}

export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'site-data.json'), 'utf-8');
  const data = JSON.parse(raw);
  return data.posts.map((p: Deal) => ({
    params: { slug: p.slug },
    props: { deal: p },
  }));
}

const { deal } = Astro.props as { deal: Deal };
const base = import.meta.env.BASE_URL;

function rewriteImage(url: string | null): string | null {
  if (!url) return null;
  return url.replace(/_AC_SR\d+,\d+_/, '_AC_SL1500_').replace(/_AC_SL\d+_/, '_AC_SL1500_');
}

const fullImage = rewriteImage(deal.imageUrl);
const parsedPrice = deal.price ? parseFloat(deal.price.replace(/[^0-9.]/g, '')) : null;
const originalPrice = parsedPrice && deal.discount > 0
  ? '$' + (parsedPrice / (1 - deal.discount / 100)).toFixed(2)
  : null;

const ratingColors: Record<string, string> = {
  FIRE: '#EF4444', HOT: '#F97316', WARM: '#EAB308', GOOD: '#22C55E',
};
const ratingColor = ratingColors[deal.rating] || '#94A3B8';

function safeEncode(s: string): string {
  try { return encodeURIComponent(s); } catch { return encodeURIComponent(s.replace(/[^\x20-\x7E]/g, '')); }
}

const dealUrl = `https://seg247.github.io${base}deals/${deal.slug}`;
const tgShare = 'https://t.me/share/url?url=' + safeEncode(dealUrl) + '&text=' + safeEncode(deal.title);
const waShare = 'https://wa.me/?text=' + safeEncode(deal.title + ' ' + dealUrl);
const fbShare = 'https://www.facebook.com/sharer/sharer.php?u=' + safeEncode(dealUrl);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: deal.title,
  url: deal.url,
  image: deal.imageUrl || undefined,
  offers: parsedPrice ? {
    '@type': 'Offer',
    price: String(parsedPrice),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: deal.url,
  } : undefined,
});
---
<Base
  title={`${deal.title} — Shopping With Noya`}
  description={`${deal.title}${deal.price ? ` for ${deal.price}` : ''} — ${deal.rating} deal on Amazon`}
  ogImage={fullImage || undefined}
  canonicalUrl={dealUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <main style="max-width:640px;margin:0 auto;padding:16px;">
    <a href={base} style="display:inline-block;margin-bottom:16px;color:var(--color-accent);font-size:14px;">← Back to Deals</a>

    {fullImage && (
      <img src={fullImage} alt={deal.title} style="width:100%;border-radius:16px;margin-bottom:16px;" loading="lazy" />
    )}

    <h1 style="font-size:22px;font-weight:700;line-height:1.3;margin-bottom:12px;">{deal.title}</h1>

    <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
      <span style="font-size:24px;font-weight:700;">{deal.price || 'See Price on Amazon'}</span>
      {originalPrice && (
        <span style="font-size:16px;color:#737373;text-decoration:line-through;">{originalPrice}</span>
      )}
      {deal.discount > 0 && (
        <span style="font-size:14px;font-weight:700;color:#EF4444;">-{deal.discount}%</span>
      )}
    </div>

    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <span style={`display:inline-flex;align-items:center;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:700;color:#fff;background:${ratingColor}`}>{deal.rating}</span>
      <span style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:12px;font-size:12px;background:rgba(0,0,0,0.04);">{deal.category}</span>
    </div>

    <a href={deal.url} target="_blank" rel="noopener noreferrer sponsored" style="display:flex;align-items:center;justify-content:center;height:52px;background:#2563EB;color:#fff;border-radius:8px;font-weight:700;font-size:16px;text-decoration:none;margin-bottom:16px;">
      🛒 View Deal on Amazon
    </a>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
      <a href={tgShare} target="_blank" rel="noopener noreferrer" style="padding:8px 14px;border-radius:8px;background:rgba(0,0,0,0.04);font-size:13px;text-decoration:none;color:inherit;">📱 Telegram</a>
      <a href={waShare} target="_blank" rel="noopener noreferrer" style="padding:8px 14px;border-radius:8px;background:rgba(0,0,0,0.04);font-size:13px;text-decoration:none;color:inherit;">💬 WhatsApp</a>
      <a href={fbShare} target="_blank" rel="noopener noreferrer" style="padding:8px 14px;border-radius:8px;background:rgba(0,0,0,0.04);font-size:13px;text-decoration:none;color:inherit;">📘 Facebook</a>
    </div>

    <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;height:44px;background:rgba(0,0,0,0.04);border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;margin-bottom:16px;color:inherit;">
      📱 Join our Telegram for more deals
    </a>

    <p style="font-size:11px;color:#737373;line-height:1.5;">
      #ad — This page contains affiliate links. As an Amazon Associate, Shopping With Noya earns from qualifying purchases. Prices and availability are subject to change.
    </p>
  </main>
</Base>
